<?xml version="1.0" encoding="utf-8"?>
<!-- Saved messages never go to cloud backup. Moving to a new phone (direct device transfer) keeps them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
